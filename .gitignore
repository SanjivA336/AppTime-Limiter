# --- Build output (regenerated by `dotnet build`) ---
[Bb]in/
[Oo]bj/
[Pp]ublish/
artifacts/
*.nupkg
*.snupkg

# --- Visual Studio / Rider / VS Code ---
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# --- Test and coverage output ---
TestResults/
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml

# --- Installer / packaging output ---
*.msix
*.msi
*.appx
*.appxbundle

# --- Secrets and local config (never commit these) ---
.env
.env.*
*.pem
*.key
*.pfx
secrets.json

# --- Personal tooling (machine-specific, not part of the project) ---
.claude/settings.local.json
.graphifyignore
graphify-out/
design-shots/

# --- OS junk ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Logs and temp files ---
*.log
*.tmp
*.bak
