# Let Git normalize line endings so Windows (CRLF) and other platforms don't
# produce noisy whole-file diffs.
* text=auto

# Windows-specific files that must keep CRLF
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Source files: normalize to LF in the repo
*.cs text
*.xaml text
*.csproj text
*.json text
*.md text

# Binary files: never touch
*.png binary
*.jpg binary
*.ico binary
