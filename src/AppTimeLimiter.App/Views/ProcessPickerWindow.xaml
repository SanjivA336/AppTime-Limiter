<ui:FluentWindow x:Class="AppTimeLimiter.App.Views.ProcessPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Add apps"
                 Width="560" Height="640" MinWidth="460" MinHeight="420"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Add apps" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="20,8,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Start the app first so it shows up here, then select it. Hold Ctrl to pick several." />

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="Search running apps" TextChanged="SearchBox_TextChanged" />
                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Refresh the list"
                           Margin="8,0,0,0" Click="Refresh_Click" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="OnlyWindows" Content="Only show apps with a window" IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,0,8" />
                <ListBox x:Name="List" Grid.Row="1" SelectionMode="Extended" MouseDoubleClick="List_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                <ui:Button x:Name="AddButton" Content="Add selected" Appearance="Primary" MinWidth="120" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
