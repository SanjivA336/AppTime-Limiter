<Page x:Class="HardCap.App.Views.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:HardCap.App.Controls"
      Title="Analytics">
    <Page.Resources>
        <!--
            One bar of the horizontal chart. Pointing at a group fades in the apps it is made of, under its bar.
            (The apps use their own, simpler template below so they don't repeat this one.)
        -->
        <DataTemplate x:Key="UsageRowTemplate">
            <Border x:Name="RowRoot" Background="Transparent" CornerRadius="6" Padding="8,7" Margin="0,1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                     Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                     Foreground="{Binding ColorBrush}" VerticalAlignment="Center" Margin="12,0" />
                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ItemsControl x:Name="AppsPanel" ItemsSource="{Binding Apps}" Visibility="Collapsed" Opacity="0" Margin="16,8,0,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="154" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                 Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                 Foreground="{Binding ColorBrush}" Opacity="0.75" VerticalAlignment="Center" Margin="12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter TargetName="AppsPanel" Property="Visibility" Value="Visible" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="AppsPanel" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.22" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Analytics" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Where your time went; usage is kept for 3 months." Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- What to look at: a day, a week or a month, and which one. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}">
                <ComboBox ItemsSource="{Binding ViewChoices}" SelectedItem="{Binding SelectedViewChoice, Mode=TwoWay}"
                          Width="104" Margin="0,0,14,0" ToolTip="Show a day, a week or a month" />
                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" ToolTip="Earlier" Command="{Binding PreviousCommand}" />
                <StackPanel Margin="14,0" MinWidth="130" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PeriodTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding PeriodRange}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" ToolTip="Later" Command="{Binding NextCommand}" />
                <ui:Button Content="{Binding CurrentButtonText}" Margin="12,0,0,0" MinWidth="92" Command="{Binding CurrentCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <!-- No groups exist at all -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasNoGroups, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="No groups yet" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0"
                                   Text="Add a group on the Limits page, and its time shows up here once its apps have been running." />
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}">

                    <!-- Which groups to look at. Pick any mix, or all, or none. -->
                    <WrapPanel Margin="0,0,0,12">
                        <ui:Button Content="{Binding SelectAllLabel}" Margin="0,0,12,8" MinWidth="104" Command="{Binding ToggleAllCommand}" />
                        <ItemsControl ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Margin="0,0,8,8" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <!-- Nothing to show: no groups picked, or nothing recorded in this period -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding ShowContent, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,28">
                            <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="40" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding EmptyMessage}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}">

                        <!-- The big numbers -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="260" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding HeroLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding HeroText}" FontSize="48" FontWeight="SemiBold" Margin="0,2,0,6"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ChangeCaption}">
                                        <Grid VerticalAlignment="Center">
                                            <Border CornerRadius="10" Background="{Binding ChangeBrush}" Opacity="0.2" />
                                            <TextBlock Text="{Binding ChangeText}" FontWeight="SemiBold" Margin="10,3"
                                                       Foreground="{Binding ChangeBrush}" />
                                        </Grid>
                                        <TextBlock Text="vs. earlier weeks" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding HasChange, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ChangeCaption}" FontSize="12" TextWrapping="Wrap" Margin="0,8,12,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <UniformGrid Grid.Column="1" Columns="3" VerticalAlignment="Center">
                                    <StackPanel Margin="12,0">
                                        <TextBlock Text="{Binding Tile1Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Tile1Text}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="12,0">
                                        <TextBlock Text="{Binding Tile2Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Tile2Text}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="12,0" ToolTip="Based on up to the four weeks before this period">
                                        <TextBlock Text="{Binding Tile3Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Tile3Text}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- The chart for the view: a ring for a day, columns for a week, a calendar of pies for a month -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ChartTitle}" />

                                <!-- Day (a column for each hour) and Week (a column for each day): the same chart -->
                                <StackPanel Visibility="{Binding ShowBarChart, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding ChartHint}" />
                                    <controls:StackedBarChart x:Name="BarChart" Height="290"
                                                              Columns="{Binding ChartColumns}"
                                                              TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                              MutedBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                              GridBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                              CardBrush="{DynamicResource ControlSolidFillColorDefaultBrush}"
                                                              CardBorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    <TextBlock Text="{Binding ChartNote}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasChartNote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <!-- Month -->
                                <StackPanel Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Each day's time, split by group; point at a day for the percentages, or click a day or week number to open it." />
                                    <controls:MonthCalendarChart x:Name="MonthChart"
                                                                 Days="{Binding Days}" Today="{Binding Today}"
                                                                 TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                                 MutedBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                                 GridBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                 AccentBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                                 CardBrush="{DynamicResource ControlSolidFillColorDefaultBrush}"
                                                                 CardBorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                                </StackPanel>

                                <!-- What the colours mean -->
                                <ItemsControl ItemsSource="{Binding Legend}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                <Ellipse Width="9" Height="9" Fill="{Binding ColorBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- A bar for each group (or each app) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Time by group" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                                   Text="How long each was running. Point at a group to see its apps." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <RadioButton GroupName="kind" Content="Groups" MinWidth="0" Margin="0,0,10,0"
                                                     IsChecked="{Binding ShowGroups, Mode=TwoWay}" />
                                        <RadioButton GroupName="kind" Content="Apps" MinWidth="0"
                                                     IsChecked="{Binding ShowApps, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource UsageRowTemplate}" />
                                <TextBlock Text="{Binding RowsNote}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
