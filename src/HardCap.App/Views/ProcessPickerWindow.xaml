<ui:FluentWindow x:Class="HardCap.App.Views.ProcessPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Add apps"
                 Width="600" Height="700" MinWidth="500" MinHeight="460"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Add apps" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="20,8,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Pick a running app (shown first), search your installed apps, or browse for the program file. Hold Ctrl to pick several." />

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="Search apps" TextChanged="SearchBox_TextChanged" />
                <ui:Button Grid.Column="1" Content="Browse…" Icon="{ui:SymbolIcon FolderOpen24}"
                           ToolTip="Pick a program file (.exe) from your computer" Margin="8,0,0,0" Click="Browse_Click" />
                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Refresh the list"
                           Margin="8,0,0,0" Click="Refresh_Click" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                    <CheckBox x:Name="ShowNotRunning" Content="Include installed apps that aren't running" IsChecked="True"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,18,4" />
                    <CheckBox x:Name="ShowBackground" Content="Include background programs"
                              ToolTip="Programs with no window, such as helpers, services and anti-cheat. They often run all day."
                              Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,0,4" />
                </WrapPanel>
                <TextBlock x:Name="Status" Grid.Row="1" Margin="0,0,0,6" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ListBox x:Name="List" Grid.Row="2" SelectionMode="Extended" MouseDoubleClick="List_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Warning}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="#F2994A"
                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Tag}" FontSize="12" VerticalAlignment="Top" Margin="12,2,4,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                <ui:Button x:Name="AddButton" Content="Add selected" Appearance="Primary" MinWidth="120" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
