<Page x:Class="Curfew.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Curfew.App.Controls"
      Title="Settings">
    <Grid Margin="24,8,24,16">

        <!-- While a wait applies, the page shows only this countdown -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
            <controls:WaitCountdownView DataContext="{Binding Countdown}"
                                        Title="Waiting to open Settings"
                                        Subtitle="You can open them when the countdown reaches zero, and it only runs while this window is in front." />
            <ui:Button Content="Back to Limits" HorizontalAlignment="Center" Margin="0,36,0,0" MinWidth="140"
                       Click="Cancel_Click" />
        </StackPanel>

        <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="These apply to the whole app, once you save them."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <ui:InfoBar Grid.Row="1" Severity="Informational" IsClosable="True" Title="Done"
                        Message="{Binding Message}"
                        IsOpen="{Binding IsMessageOpen, Mode=TwoWay}"
                        Margin="0,0,0,10" />

            <!-- When the page is wide enough, a list of sections appears on the left and shows one card at a time. -->
            <Grid x:Name="Body" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Sidebar" Grid.Column="0" Style="{StaticResource SectionSidebarList}" Margin="0,0,16,0" />
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">

                    <Border x:Name="GeneralCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="General" />
                            <ui:ToggleSwitch Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResetCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Daily reset" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Daily budgets refill at this time, so if you stay up past midnight, pick when you usually go to sleep (such as 4:00 AM) and late-night play counts toward the day before." />
                            <ComboBox ItemsSource="{Binding TimeChoices}" SelectedItem="{Binding SelectedReset, Mode=TwoWay}"
                                      Width="150" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding ResetSummary}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="FrictionCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Global friction" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="A wait before opening these settings or quitting Curfew makes the rules harder to change in a weak moment; quitting also waits as long as your longest Edit friction, and the countdown only runs while the window is in front." />
                            <StackPanel Orientation="Horizontal">
                                <ui:NumberBox Value="{Binding Wait.Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="-1" Maximum="9" SmallChange="1" LargeChange="1"
                                              MaxDecimalPlaces="0" Width="150" ClearButtonEnabled="False" />
                                <TextBlock Text="min" VerticalAlignment="Center" Margin="8,0,18,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:NumberBox Value="{Binding Wait.Seconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="-300" Maximum="900" SmallChange="5" LargeChange="15"
                                              MaxDecimalPlaces="0" Width="150" ClearButtonEnabled="False" />
                                <TextBlock Text="sec" VerticalAlignment="Center" Margin="8,0,18,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Wait.Summary}" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <ui:ToggleSwitch Content="Frictionless hours: no global friction at these times" Margin="0,16,0,0"
                                             IsChecked="{Binding OpenHoursEnabled, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding OpenHoursEnabled, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding TimeChoices}" SelectedItem="{Binding OpenHoursStart, Mode=TwoWay}" Width="130" />
                                <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding TimeChoices}" SelectedItem="{Binding OpenHoursEnd, Mode=TwoWay}" Width="130" />
                            </StackPanel>
                            <TextBlock Text="{Binding OpenHoursSummary}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="AwayCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Away" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Stop counting time toward budgets (and in Analytics) after this long without keyboard or mouse input; game controllers aren't detected." />
                            <ui:ToggleSwitch Content="Don't count time while I'm away" IsChecked="{Binding IdleDetectionEnabled, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding IdleDetectionEnabled, Converter={StaticResource BoolToVisibility}}">
                                <ui:NumberBox Value="{Binding IdleMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="1" Maximum="60" SmallChange="1" LargeChange="5"
                                              MaxDecimalPlaces="0" Width="150" ClearButtonEnabled="False" />
                                <TextBlock Text="minutes without input" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding IdleSummary}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="BackupCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Back up your settings" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Export your groups and settings to a file or load them back; importing replaces everything above, and your usage history isn't included." />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Export…" Icon="{ui:SymbolIcon ArrowUpload24}" Click="Export_Click" Margin="0,0,10,0"
                                           IsEnabled="{Binding NoChanges}" />
                                <ui:Button Content="Import…" Icon="{ui:SymbolIcon ArrowDownload24}" Click="Import_Click"
                                           IsEnabled="{Binding NoChanges}" />
                            </StackPanel>
                            <TextBlock Text="Save or revert your changes first, then you can export or import." Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <!-- Footer: changes only count once "Save changes" is pressed, like the group editor. -->
            <Grid Grid.Row="3" Margin="0,12,0,4">
                <TextBlock Text="You have changes that aren't saved yet." VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="RevertButton" Content="Revert" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="0,0,10,0"
                               IsEnabled="{Binding HasChanges}"
                               ToolTip="Put everything back to what is saved"
                               Click="Revert_Click" />
                    <ui:Button x:Name="SaveButton" Content="Save changes" Appearance="Primary" MinWidth="130"
                               IsEnabled="{Binding HasChanges}"
                               ToolTip="Leaving this page any other way throws your changes away"
                               Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
