<ui:FluentWindow x:Class="Curfew.App.Views.GroupEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Curfew.App.Controls"
                 Title="Edit group"
                 Width="1020" Height="900" MinWidth="720" MinHeight="560"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Edit group" ShowMinimize="False" ShowMaximize="False" />

        <!--
            The lock screen. A locked group shows only this, in the same sized window, until the countdown reaches zero.
            Nothing about the group is visible or editable meanwhile, and closing the window and opening it again
            starts the full wait over.
        -->
        <StackPanel Grid.Row="1" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
            <controls:WaitCountdownView DataContext="{Binding Countdown}"
                                        Title="Waiting to open this group"
                                        Subtitle="You can open it when the countdown reaches zero, and it only runs while this window is in front." />
            <ui:Button Content="Cancel" HorizontalAlignment="Center" Margin="0,36,0,0" MinWidth="120" Click="CancelLock_Click" />
        </StackPanel>

        <!-- Problems with what was just typed or picked (a name already used, an app in another group...). -->
        <ui:InfoBar Grid.Row="1" Severity="Warning" IsClosable="True" Title="Notice"
                    Message="{Binding Message}"
                    IsOpen="{Binding IsNoticeOpen, Mode=TwoWay}"
                    Margin="24,4,24,4" />

        <!-- Closing this window without pressing "Save changes" throws every change away. -->
        <!--
            When the window is wide enough, a list of sections appears on the left and the tabs are hidden (the list takes over),
            showing one section at a time; when it is narrow, the tabs and stacked cards below work as they always did.
        -->
        <Grid x:Name="Body" Grid.Row="2" Margin="24,0,24,0"
              Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="Sidebar" Grid.Column="0" Style="{StaticResource SectionSidebarList}" />
        <TabControl x:Name="Tabs" Grid.Column="1">

            <!-- ============================ General ============================ -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,12,8">

                        <!-- Name and color -->
                        <Border x:Name="GroupCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Group" />
                                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" PlaceholderText="Group name"
                                            Margin="0,6,0,12" />
                                <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" />
                            </StackPanel>
                        </Border>

                        <!-- Apps and warnings, side by side -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AppsCard" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Apps" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Each app can be in only one group." />
                                    <ItemsControl ItemsSource="{Binding Processes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss16}" ToolTip="Remove from group"
                                                               Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" Appearance="Transparent" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:Button Content="Add apps…" Icon="{ui:SymbolIcon Add24}" Margin="0,8,0,0"
                                               Click="AddApps_Click" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="WarningsCard" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Warnings" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Get a notification this many minutes before an app is closed. Up to three, each a different number." />
                                    <ItemsControl ItemsSource="{Binding Warnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <ui:NumberBox Value="{Binding Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="1440"
                                                                  MaxDecimalPlaces="0" Width="160" ClearButtonEnabled="False" />
                                                    <TextBlock Text="minutes before" VerticalAlignment="Center" Margin="8,0"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <ui:Button Icon="{ui:SymbolIcon Dismiss16}" ToolTip="Remove warning" Appearance="Transparent"
                                                               Command="{Binding DataContext.RemoveWarningCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />
                                                    <TextBlock Text="same as another" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#EB5757"
                                                               Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:Button Content="Add warning" Icon="{ui:SymbolIcon Add24}" Margin="0,8,0,0"
                                               Command="{Binding AddWarningCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Grace period and pause, side by side -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Grace period: time to save when a limit starts while an app is running -->
                            <Border x:Name="GraceCard" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Grace period" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="How long a running app has before it closes when the budget runs out or a Blocked time begins, up to 5 minutes (apps opened during a block close right away)." />
                                    <!-- This card is only half as wide as the lock card, so the two boxes drop onto separate lines if they don't fit side by side. -->
                                    <WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                            <ui:NumberBox Value="{Binding Grace.Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="-1" Maximum="9" SmallChange="1" LargeChange="1"
                                                          MaxDecimalPlaces="0" Width="150" ClearButtonEnabled="False" />
                                            <TextBlock Text="min" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <ui:NumberBox Value="{Binding Grace.Seconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="-300" Maximum="900" SmallChange="5" LargeChange="15"
                                                          MaxDecimalPlaces="0" Width="150" ClearButtonEnabled="False" />
                                            <TextBlock Text="sec" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Grace.Summary}" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Pause: treat the group as Free for a while -->
                            <Border x:Name="PauseCard" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Pause" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Treat this group as Free for a while, so nothing is limited or closed and its time isn't charged to the budget." />
                                    <ComboBox ItemsSource="{Binding PauseOptions}" SelectedItem="{Binding SelectedPauseOption, Mode=TwoWay}"
                                              MinWidth="230" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding IsDateTimePause, Converter={StaticResource BoolToVisibility}}">
                                        <ComboBox ItemsSource="{Binding PauseDays}" SelectedItem="{Binding SelectedPauseDay, Mode=TwoWay}" Width="140" />
                                        <TextBlock Text="at" VerticalAlignment="Center" Margin="8,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding PauseTimes}" SelectedItem="{Binding SelectedPauseTime, Mode=TwoWay}" Width="110" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding PauseSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Count time: what uses up the budget -->
                        <Border x:Name="CountCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="What counts" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Choose what uses up this group's budget; both are always recorded, and closing apps never depends on it." />
                                <RadioButton GroupName="CountMode" Content="Any time it's running"
                                             IsChecked="{Binding CountsWhileRunning, Mode=TwoWay}" />
                                <RadioButton GroupName="CountMode" Content="Only when it's in front (time in the background doesn't count)"
                                             IsChecked="{Binding CountsWhileInFront, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <!-- The lock: how long to wait the next time this group is opened -->
                        <Border x:Name="FrictionCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Edit friction" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="A wait before this group can be opened or changed, up to 5 minutes (0 means none, and a paused group ignores it); the countdown only runs while the window is in front." />
                                <StackPanel Orientation="Horizontal">
                                    <!-- The ranges are wider than what is allowed on purpose: stepping past 59 or below 0
                                         has to reach the code, which carries it into the minutes and tidies the result. -->
                                    <ui:NumberBox Value="{Binding Lock.Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Minimum="-1" Maximum="9" SmallChange="1" LargeChange="1"
                                                  MaxDecimalPlaces="0" Width="150" ClearButtonEnabled="False" />
                                    <TextBlock Text="min" VerticalAlignment="Center" Margin="8,0,18,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:NumberBox Value="{Binding Lock.Seconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Minimum="-300" Maximum="900" SmallChange="5" LargeChange="15"
                                                  MaxDecimalPlaces="0" Width="150" ClearButtonEnabled="False" />
                                    <TextBlock Text="sec" VerticalAlignment="Center" Margin="8,0,18,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Lock.Summary}" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Launch friction: a newly started app of this group is frozen behind a countdown -->
                        <Border x:Name="LaunchCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Launch friction" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="When one of this group's apps starts, freeze it behind a countdown of up to 60 seconds (0 means off); Cancel closes it, a paused group skips it, and an app that can't be frozen is left alone." />
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox Value="{Binding LaunchFrictionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Minimum="0" Maximum="60" SmallChange="5" LargeChange="15"
                                                  MaxDecimalPlaces="0" Width="150" ClearButtonEnabled="False" />
                                    <TextBlock Text="sec" VerticalAlignment="Center" Margin="8,0,18,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding LaunchFrictionSummary}" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Freezing an app as it starts may break things, especially games with anti-cheat. Try a short wait first, and turn this off for anything that misbehaves."
                                           FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#F2994A" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ Schedule ============================ -->
            <TabItem Header="Schedule">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,12,8">
                        <Border x:Name="ScheduleCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Weekly schedule" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Pick a brush, then drag across the grid (click a day's name to fill it); each cell is 30 minutes, and days with Limited time get a daily budget above their column." />

                                <!-- Left: which brush to paint with. Right: a readout of whatever cell the mouse is over. -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <RadioButton GroupName="paint" Content="Free" Checked="Paint_Checked" Tag="Free" MinWidth="0" Margin="0,0,16,0" />
                                        <RadioButton GroupName="paint" Content="Limited" Checked="Paint_Checked" Tag="Limited" IsChecked="True" MinWidth="0" Margin="0,0,16,0" />
                                        <RadioButton GroupName="paint" Content="Blocked" Checked="Paint_Checked" Tag="Blocked" MinWidth="0" />
                                    </StackPanel>

                                    <!-- The text takes whatever room is left and is trimmed with "…" if it ever runs out. -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="HoverText" Grid.Column="0" TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="Hover over the grid to see a time slot" />
                                        <Border x:Name="HoverSwatch" Grid.Column="1" Width="12" Height="12" CornerRadius="2"
                                                Margin="10,1,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        <TextBlock x:Name="HoverState" Grid.Column="2" FontWeight="SemiBold" Visibility="Collapsed"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Grid>

                                <!-- One budget box per day, lined up above that day's column. Shown once there is any Limited time. -->
                                <Grid Margin="0,0,0,6"
                                      Visibility="{Binding HasLimitedTime, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Static controls:ScheduleGridControl.TimeColumnLength}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Budget (min)" FontSize="11" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DayBudgets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:NumberBox Value="{Binding Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding IsEnabled}"
                                                              ToolTip="{Binding ToolTipText}"
                                                              Minimum="0" Maximum="1440" SmallChange="5" LargeChange="30"
                                                              MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                                              SpinButtonPlacementMode="Hidden"
                                                              TextAlignment="Center"
                                                              Margin="3,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <controls:ScheduleGridControl x:Name="ScheduleGrid" Schedule="{Binding Schedule}"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                              ScheduleEdited="Grid_ScheduleEdited" />

                                <WrapPanel Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                        <Border Width="12" Height="12" CornerRadius="2" Background="#6B7280" Margin="0,0,6,0" />
                                        <TextBlock Text="Free: tracked, doesn't use the budget"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                        <Border Width="12" Height="12" CornerRadius="2" Background="#3B82F6" Margin="0,0,6,0" />
                                        <TextBlock Text="Limited: uses this group's daily budget"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Width="12" Height="12" CornerRadius="2" Background="#D64545" Margin="0,0,6,0" />
                                        <TextBlock Text="Blocked: closed right away"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Visibility="{Binding HasLimitedTime, Converter={StaticResource BoolToVisibility}}"
                                           Text="{Binding UsedTodayText}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                                           Visibility="{Binding HasLimitedTime, Converter={StaticResource BoolToVisibility}}"
                                           Text="{Binding BudgetNoteText}" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="Copy" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="CopyFrom" Width="130" />
                                    <TextBlock Text="to" VerticalAlignment="Center" Margin="8"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="CopyTo" Width="190" />
                                    <ui:Button Content="Copy" Margin="10,0,0,0" Click="Copy_Click"
                                               ToolTip="Copies the day's schedule and, if it has Limited time, its budget" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- A future "Analytics" tab for this group's usage goes here. -->
        </TabControl>
        </Grid>

        <!-- Footer: always visible. Changes only count once "Save changes" is pressed. -->
        <Grid Grid.Row="3" Margin="24,12,24,20"
              Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
            <ui:Button Content="Delete group" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                       HorizontalAlignment="Left" Click="DeleteGroup_Click"
                       Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="RevertButton" Content="Revert" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="0,0,10,0"
                           IsEnabled="{Binding HasChanges}"
                           ToolTip="Put everything back to how it was when you opened this window"
                           Click="Revert_Click" />
                <ui:Button x:Name="SaveButton" Content="Save changes" Appearance="Primary" MinWidth="130"
                           ToolTip="Closing this window any other way throws your changes away"
                           Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
