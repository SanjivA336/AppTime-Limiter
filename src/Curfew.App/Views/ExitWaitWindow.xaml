<ui:FluentWindow x:Class="Curfew.App.Views.ExitWaitWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Curfew.App.Controls"
                 Title="Quit Curfew"
                 Width="520" Height="520" MinWidth="440" MinHeight="460"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Quit Curfew" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,24">
            <!-- Still waiting -->
            <StackPanel Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
                <controls:WaitCountdownView DataContext="{Binding Countdown}"
                                            Title="Waiting to quit"
                                            Subtitle="Quitting Curfew switches off every limit; you can quit when the countdown reaches zero, and it only runs while this window is in front." />
                <ui:Button Content="Keep Curfew running" HorizontalAlignment="Center" Margin="0,36,0,0" MinWidth="180"
                           Click="Keep_Click" />
            </StackPanel>

            <!-- The wait is over -->
            <StackPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Power24" FontSize="56" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Quit Curfew?" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0,16,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Nothing will be limited or closed until you start it again." HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                    <ui:Button Content="Keep running" MinWidth="130" Margin="0,0,10,0" Click="Keep_Click" />
                    <ui:Button Content="Quit Curfew" Appearance="Danger" MinWidth="130" Click="Quit_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
